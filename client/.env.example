# ===============================================
# StyleHub Client Environment Variables Template
# ===============================================

# Backend API URL (Production backend deployment URL)
# Example for Render/Railway: https://stylehub-api.onrender.com/api
# Example for local development: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# Stripe Public Publishable Key (Optional)
VITE_STRIPE_PUBLIC_KEY=pk_test_...
