# ===============================================
# StyleHub Server Environment Variables Template
# ===============================================

# Port (Defaults to 5000)
PORT=5000

# Cloud PostgreSQL Connection URL (e.g. Supabase, Neon, Render, Railway, Aiven)
# Recommended for cloud production:
DATABASE_URL=postgresql://postgres:password@your-db-host.com:5432/stylehub?sslmode=require

# Or Individual PostgreSQL Connection Parameters:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stylehub
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Frontend Client URL (for CORS and redirection)
CLIENT_URL=http://localhost:5173

# Payment Gateway (Optional / Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
